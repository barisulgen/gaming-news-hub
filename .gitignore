# dependencies
/node_modules

# next.js build output
/.next/
/out/
/build

# typescript — both are generated, next-env.d.ts is rewritten on every build
*.tsbuildinfo
next-env.d.ts

# testing
/coverage

# tuning reports written by `npm run dump:unclassified`, regenerate on demand
/reports/

# env files — this app has no secrets today, but nothing here should ever be committed
.env*
!.env.example

# claude code — the whole directory stays local
.claude

# editors and os
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# deploy
.vercel
